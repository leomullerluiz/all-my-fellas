# ---------------------------------------------------------------------------
# Claude provider — set EXACTLY ONE of the two.
# ---------------------------------------------------------------------------

# Subscription mode (default). Generate with `claude setup-token` after
# installing the Claude Code CLI (`npm i -g @anthropic-ai/claude-code`).
CLAUDE_CODE_OAUTH_TOKEN=

# Pay-per-use alternative (Anthropic Console API key).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Repository credentials — used by the worker only, never exposed to agents.
#
# Set the variable for the host you actually use; the others can stay empty.
# A repository connection may also point at a variable of its own name (for a
# second account on the same host, say) from Settings -> Repositories.
# ---------------------------------------------------------------------------

# GitHub Personal Access Token, minimum `repo` scope.
GITHUB_TOKEN=

# GitLab personal or project access token, scopes `api` + `write_repository`.
GITLAB_TOKEN=

# Bitbucket Cloud repository/workspace access token, scopes `repository:write`
# and `pullrequest:write`. A legacy app password works too, but then set the
# connection's credential username to your Atlassian account name.
BITBUCKET_TOKEN=

# Azure DevOps PAT, scopes `Code (read & write)` + `Pull Request Contribute`.
AZURE_DEVOPS_TOKEN=

# Fallback for a generic git server. A generic connection must name its own
# variable, so this is only the suggestion offered in the UI.
GIT_TOKEN=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

DATABASE_URL=file:./data/pipeline.db
WORKSPACES_DIR=./workspaces

# How many tasks the worker may execute concurrently. Keep at 1 while running
# on a Claude subscription so a single pipeline does not exhaust the quota.
MAX_PARALLEL_TASKS=1

# Maximum rework cycles back to Development before the task fails. Shared by the
# code reviewer, QA and the human review. The old QA_MAX_CYCLES is still read.
REWORK_MAX_CYCLES=2

# Who the pipeline's commits are attributed to.
GIT_AUTHOR_NAME=All My Fellas Pipeline
GIT_AUTHOR_EMAIL=pipeline@localhost

# Models per role tier. Any Claude model id is accepted.
MODEL_DEFAULT=claude-sonnet-5
MODEL_LIGHT=claude-haiku-4-5
MODEL_HEAVY=claude-opus-5

# Days to keep a task workspace on disk after delivery (0 = delete immediately).
WORKSPACE_RETENTION_DAYS=7
