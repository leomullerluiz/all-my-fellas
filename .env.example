# ---------------------------------------------------------------------------
# Claude provider — set EXACTLY ONE of the two. This is the default provider
# for every role; leave this section as-is and nothing else changes.
# ---------------------------------------------------------------------------

# Subscription mode (default). Generate with `claude setup-token` after
# installing the Claude Code CLI (`npm i -g @anthropic-ai/claude-code`).
CLAUDE_CODE_OAUTH_TOKEN=

# Pay-per-use alternative (Anthropic Console API key).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# ChatGPT and Gemini providers — optional. Only needed if you switch a role's
# provider away from Claude in Settings. See docs/llm-providers.md.
# ---------------------------------------------------------------------------

# OpenAI API key, from platform.openai.com/api-keys. Required to run any role
# whose provider is set to ChatGPT.
OPENAI_API_KEY=

# Google AI Studio API key, from aistudio.google.com/apikey. Required to run
# any role whose provider is set to Gemini. GOOGLE_API_KEY is accepted as an
# alias and wins if both are set (matches the underlying @google/genai SDK).
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Repository credentials — used by the worker only, never exposed to agents.
#
# Set the variable for the host you actually use; the others can stay empty.
# A repository connection may also point at a variable of its own name (for a
# second account on the same host, say) from Settings -> Repositories.
# ---------------------------------------------------------------------------

# GitHub Personal Access Token, minimum `repo` scope.
GITHUB_TOKEN=

# GitLab personal or project access token, scopes `api` + `write_repository`.
GITLAB_TOKEN=

# Bitbucket Cloud repository/workspace access token, scopes `repository:write`
# and `pullrequest:write`. A legacy app password works too, but then set the
# connection's credential username to your Atlassian account name.
BITBUCKET_TOKEN=

# Azure DevOps PAT, scopes `Code (read & write)` + `Pull Request Contribute`.
AZURE_DEVOPS_TOKEN=

# Fallback for a generic git server. A generic connection must name its own
# variable, so this is only the suggestion offered in the UI.
GIT_TOKEN=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

DATABASE_URL=file:./data/pipeline.db
WORKSPACES_DIR=./workspaces

# Where the dashboard is reachable. Used to build the link inside an outbound
# webhook notification — the worker has no request to derive an origin from.
APP_URL=http://localhost:3000

# How many tasks the worker may execute concurrently. Keep at 1 while running
# on a Claude subscription so a single pipeline does not exhaust the quota.
MAX_PARALLEL_TASKS=1

# Maximum rework cycles back to Development before the task fails. Shared by
# every source that can send work back: mechanical verification, the code
# reviewer, QA, a human "request changes", and homologation. A retry after an
# exhausted budget grants one extra cycle. The old QA_MAX_CYCLES is still read.
REWORK_MAX_CYCLES=2

# Who the pipeline's commits are attributed to.
GIT_AUTHOR_NAME=All My Fellas Pipeline
GIT_AUTHOR_EMAIL=pipeline@localhost

# Claude's model tiers. A role stores which tier it wants, not a literal id, so
# these only apply to roles running on Claude — ChatGPT and Gemini have their
# own fixed tier tables (see docs/llm-providers.md).
MODEL_DEFAULT=claude-sonnet-5
MODEL_LIGHT=claude-haiku-4-5
MODEL_HEAVY=claude-opus-5

# Days to keep a task workspace on disk after delivery (0 = delete immediately).
WORKSPACE_RETENTION_DAYS=7

# Days to keep full agent transcripts. Leave empty to keep them forever (the
# default): a workspace is a reproducible cache, a transcript is not. A pruned
# transcript leaves a tombstone, so the run still says it existed.
TRANSCRIPT_RETENTION_DAYS=

# ---------------------------------------------------------------------------
# Spend quota — seeds the defaults the Settings screen then overrides.
#
# There is no API that reports a real Pro/Max allowance or an outstanding bill,
# so these are always numbers you choose. Leave a limit empty and that pool
# shows no usage figure. Whether exceeding a limit *refuses a start* is a
# Settings choice (off / warn / hold), not a variable here.
#
# Cadence: daily (default) | hourly | monthly, measured in local time.
# ---------------------------------------------------------------------------

# Claude via CLAUDE_CODE_OAUTH_TOKEN.
QUOTA_SUBSCRIPTION_LIMIT_USD=
QUOTA_SUBSCRIPTION_CADENCE=daily

# Claude via ANTHROPIC_API_KEY.
QUOTA_API_KEY_LIMIT_USD=
QUOTA_API_KEY_CADENCE=daily

# Every role running on OpenAI.
QUOTA_CHATGPT_LIMIT_USD=
QUOTA_CHATGPT_CADENCE=daily

# Every role running on Google.
QUOTA_GEMINI_LIMIT_USD=
QUOTA_GEMINI_CADENCE=daily
